  "mainPath": ["q", "cache", "enhance", "emb", "qdrant", "rrf", "rerank", "fallback", "thr", "out"],
  "nodes": [
    { "id": "q", "lane": "entry", "col": 0, "width": 116, "type": "frontend", "label": "问题与影像", "sublabel": "医生输入" },
    { "id": "cache", "lane": "cache", "col": 1, "width": 124, "type": "database", "label": "先查缓存", "sublabel": "Redis 1 小时 内存 5 分钟" },
    { "id": "enhance", "lane": "cache", "col": 2, "width": 124, "type": "backend", "label": "改写问题", "sublabel": "同义词扩展 可选大模型改写" },
    { "id": "emb", "lane": "dense", "col": 2, "width": 116, "type": "cloud", "label": "问题变数字", "sublabel": "bge-m3 医学版 1024 维" },
    { "id": "qdrant", "lane": "dense", "col": 3, "width": 116, "type": "database", "label": "找最近段落", "sublabel": "向量库 1257 段 余弦距离" },
    { "id": "bm25", "lane": "kw", "col": 2, "width": 112, "type": "backend", "label": "按关键词找", "sublabel": "BM25 两字窗口 不分词" },
    { "id": "ulc", "lane": "img", "col": 2, "width": 120, "type": "cloud", "label": "影像找相似", "sublabel": "超声专用 512 维 库里暂无数据" },
    { "id": "rrf", "lane": "fuse", "col": 3, "width": 116, "type": "backend", "label": "三路合成一列", "sublabel": "RRF 倒数排名融合 k 为 60" },
    { "id": "rerank", "lane": "fuse", "col": 4, "width": 150, "type": "cloud", "label": "按相关重排", "sublabel": "bge 重排 超时 5 秒退简易算法" },
    { "id": "fallback", "lane": "weak", "col": 4, "width": 120, "type": "backend", "label": "结果太少就补", "sublabel": "最高分低于 0.3 或不足 3 条" },
    { "id": "thr", "lane": "weak", "col": 5, "width": 120, "type": "security", "label": "丢掉低分", "sublabel": "低于 0.5 不要 图谱邻居例外" },
    { "id": "out", "lane": "out", "col": 5, "width": 116, "type": "frontend", "label": "交五段资料", "sublabel": "给专科智能体" }
  ],
  "edges": [
    { "from": "q", "to": "cache", "label": "第一步", "variant": "emphasis" },
    { "from": "cache", "to": "enhance", "label": "没命中", "variant": "emphasis" },
    { "from": "enhance", "to": "emb", "label": "文字", "variant": "emphasis" },
    { "from": "emb", "to": "qdrant", "label": "向量", "variant": "emphasis" },
    { "from": "enhance", "to": "bm25", "label": "关键词", "variant": "dashed" },
    { "from": "enhance", "to": "ulc", "label": "影像", "variant": "dashed" },
    { "from": "qdrant", "to": "rrf", "label": "候选", "variant": "emphasis" },
    { "from": "bm25", "to": "rrf", "label": "候选", "variant": "dashed" },
    { "from": "ulc", "to": "rrf", "label": "可能为空", "variant": "dashed" },
    { "from": "rrf", "to": "rerank", "label": "合成后重排", "variant": "emphasis" },
    { "from": "rerank", "to": "fallback", "label": "太少则补", "variant": "security" },
    { "from": "fallback", "to": "thr", "label": "再过滤", "variant": "emphasis" },
    { "from": "thr", "to": "out", "label": "剩五段", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "用到的模型 与当初为什么这么选",
      "items": [
        "文字变数字 用 bge-m3 医学版 1024 维 中文医学语料上稳 单条 10 毫秒级",
        "关键词那一路不用分词库 改成两字窗口 少一个依赖 也方便测",
        "重排用 bge 重排模型 排不动时退回简易相似度 保证不卡住",
        "影像那一路本来是超声专用模型 512 维 但库里没有影像数据 现在等于空跑"
      ]
    },
    {
      "dot": "rose",
      "title": "三个关键参数",
      "items": [
        "融合参数 60 越大越看名次 不看分数 免得两路分数不可比",
        "进上下文的只有五段 多了反而干扰生成",
        "分数低于 0.5 丢掉 但图谱来的邻居例外 否则开了也等于没开"
      ]
    },
    {
      "dot": "emerald",
      "title": "每一步坏了会怎样",
      "items": [
        "缓存坏了 当作没缓存 继续走真检索",
        "文字那一路坏了 只剩关键词那一路 结果会变差但不会断",
        "重排服务超时 五秒后退回简易算法 并留下记录",
        "任何一步失败都写日志 不允许安静跳过"
      ]
    }
  ]
}
