    { "id": "kw", "label": "第二路 关键词" },
    { "id": "img", "label": "第三路 影像相似" },
    { "id": "fuse", "label": "合并与重排" },
    { "id": "weak", "label": "兜底与过滤" },
    { "id": "out", "label": "交给生成" }
