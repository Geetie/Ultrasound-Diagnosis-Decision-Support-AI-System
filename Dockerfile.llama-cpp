FROM python:3.13-slim

RUN pip install --no-cache-dir \
    llama-cpp-python==0.3.22 \
    uvicorn==0.34.2 \
    starlette==0.46.2 \
    huggingface-hub>=0.30.0

WORKDIR /app
COPY scripts/llama_cpp_server.py /app/server.py

RUN mkdir -p /models

EXPOSE 8001

CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "8001"]
